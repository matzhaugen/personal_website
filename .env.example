# Password gating for posts with `hidden: true` frontmatter and the /law routes.
BLOG_PASSWORD=

# Answer generation for the AI Doctor (/api/doctor-chat). Both keys are read at
# runtime via $env/dynamic/private, so an `export ..._API_KEY=...` in
# ~/.bash_profile (as this machine does) is picked up by `npm run dev` without
# putting the key in the repo — leave these blank in that case. In production
# they are set in the Netlify site env.
#
# The endpoint tries the providers in order and fails over on a rate limit, so
# either one alone is enough to serve answers; with neither set, the chat
# reports that the model isn't configured.
#
# Use keys from accounts with NO billing attached: over the free tier those
# return HTTP 429/402 instead of a charge, which is the real cost backstop.

# Preferred backend — Cerebras (gpt-oss-120b). Chosen first because Groq's ~6k
# TPM free tier is only ~1 question/minute site-wide.
CEREBRAS_API_KEY=

# Failover backend — Groq (llama-3.1-8b-instant).
GROQ_API_KEY=

# DigitalOcean Spaces credentials for `npm run assets`, which uploads blog media
# and the AI Doctor retrieval index from static/ to the `stackmap` bucket
# (region sfo3). Only needed when publishing — never read at build or run time.
# Create a key pair under API > Spaces Keys in the DO control panel.
#
# The script reads .env first, then falls back to the process environment, so
# exporting these from ~/.bash_profile (as this machine does) works too and
# keeps them out of the repo entirely. Leave them blank here in that case.
DO_ACCESS_KEY=
DO_SECRET_KEY=

# Origin the figure/video components prefix onto media paths. Netlify sets this
# in netlify.toml; leave it unset locally to serve from static/ instead.
# VITE_ASSET_BASE=https://stackmap.sfo3.cdn.digitaloceanspaces.com
